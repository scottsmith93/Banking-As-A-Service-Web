{
  "name": "designer-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=20.19 <24",
    "npm": ">=11.11.1"
  },
  "scripts": {
    "setup": "npm install",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "vite --port 5173 --strictPort",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "validate": "npm run validate:locales && npm run validate:tokens",
    "build": "npm run validate && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@sage/design-tokens": "^4.35.0",
    "@sage/design-tokens-fusion": "npm:@sage/design-tokens@^18.14.2",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "carbon-react": "^159.2.0",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
